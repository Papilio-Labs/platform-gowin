// Constraint file for Papilio RetroCade board
// Auto-Builder Example

// System clock - 27 MHz
IO_LOC "clk_27mhz" 4;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS33;

// Reset button (directly active-low on button press)
IO_LOC "rst_n" 88;
IO_PORT "rst_n" IO_TYPE=LVCMOS33;

// SPI Interface to ESP32
IO_LOC "spi_sclk" 77;
IO_PORT "spi_sclk" IO_TYPE=LVCMOS33;

IO_LOC "spi_mosi" 76;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33;

IO_LOC "spi_miso" 75;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33;

IO_LOC "spi_cs_n" 63;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33;

// LEDs
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_LOC "led[6]" 17;
IO_LOC "led[7]" 18;

IO_PORT "led[0]" IO_TYPE=LVCMOS33;
IO_PORT "led[1]" IO_TYPE=LVCMOS33;
IO_PORT "led[2]" IO_TYPE=LVCMOS33;
IO_PORT "led[3]" IO_TYPE=LVCMOS33;
IO_PORT "led[4]" IO_TYPE=LVCMOS33;
IO_PORT "led[5]" IO_TYPE=LVCMOS33;
IO_PORT "led[6]" IO_TYPE=LVCMOS33;
IO_PORT "led[7]" IO_TYPE=LVCMOS33;
